# MarketMind Environment Configuration
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to git

# ========================
# LLM API Keys
# ========================
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ========================
# Market Data API Keys
# ========================
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key-here
FINNHUB_API_KEY=your-finnhub-key-here

# ========================
# Model Configuration
# ========================
# Routine tasks (price lookups, formatting, simple summaries)
ROUTINE_MODEL=gpt-4o-mini
# Deep analysis (stock analysis, buy/sell reasoning, multi-factor evaluation)
ANALYSIS_MODEL=claude-sonnet-4-20250514

# ========================
# Cost Tracking
# ========================
# Monthly budget limit in USD — agent will warn when approaching this
MONTHLY_BUDGET_LIMIT=30.00

# ========================
# SEC EDGAR (required for filing ingestion)
# ========================
# SEC requires a User-Agent string. This is NOT private info.
SEC_EDGAR_IDENTITY=MarketMind your.email@example.com

# ========================
# Embedding Model (downloaded automatically on first use, ~400MB)
# ========================
EMBEDDING_MODEL=all-mpnet-base-v2

# ========================
# Application Settings
# ========================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Where to store local data (portfolios, cache, etc.)
DATA_DIR=./data
